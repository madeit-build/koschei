@@ -307,13 +309,22 @@ WebIDL::ExceptionOr<bool> Document::query_command_enabled(Utf16FlyString const&
     // INTEROP: The spec lists undo and redo among the always-enabled miscellaneous commands, but in Chromium
     //          queryCommandEnabled("undo") is true only when there is a step to undo, and execCommand("undo") on an
     //          empty history returns false. Redo behaves symmetrically.
+    // A sealed <input> (see HTML::SealedField) records its edits so the user can undo them from the keyboard, but
+    // script must not replay them: execCommand("undo") followed by a validity read is a per-character oracle on the
+    // user's value. The keyboard shortcut path (Editing::perform_history_action) does not come through here.
+    auto step_edits_sealed_text_control = [](GC::Ptr<Editing::UndoStep> step) {
+        if (!step)
+            return false;
+        auto* control = dynamic_cast<HTML::FormAssociatedTextControlElement*>(step->editing_host().ptr());
+        return control && control->is_sealed_text_control();
+    };
     if (command.equals_ignoring_ascii_case(Editing::CommandNames::undo)) {
         auto history = editing_history_if_exists();
-        return history && history->can_undo();
+        return history && history->can_undo() && !step_edits_sealed_text_control(history->next_undo_step());
     }
     if (command.equals_ignoring_ascii_case(Editing::CommandNames::redo)) {
         auto history = editing_history_if_exists();
-        return history && history->can_redo();
+        return history && history->can_redo() && !step_edits_sealed_text_control(history->next_redo_step());
     }
 
     // AD-HOC: selectAll requires a selection object to exist.
@@ -325,6 +336,19 @@ WebIDL::ExceptionOr<bool> Document::query_command_enabled(Utf16FlyString const&
     if (!active_range)
         return false;
 
+    // A range inside a sealed <input>'s shadow tree never enables an editing command. Today the shadow tree is not
+    // editable anyway; this keeps execCommand a no-op for sealed fields even if that changes.
+    auto range_is_inside_sealed_text_control = [](DOM::Node& node) {
+        auto* shadow_root = as_if<ShadowRoot>(node.root());
+        if (!shadow_root)
+            return false;
+        auto* control = dynamic_cast<HTML::FormAssociatedTextControlElement*>(shadow_root->host());
+        return control && control->is_sealed_text_control();
+    };
+    if (range_is_inside_sealed_text_control(*active_range->start_container())
+        || range_is_inside_sealed_text_control(*active_range->end_container()))
+        return false;
+
     // its start node is either editable or an editing host,
     auto start_node = active_range->start_container();
     if (!start_node->is_editable_or_editing_host())
