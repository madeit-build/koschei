diff --git a/Tests/LibCrypto/TestHPKE.cpp b/Tests/LibCrypto/TestHPKE.cpp
index 51c339b8..6c11d7b6 100644
--- a/Tests/LibCrypto/TestHPKE.cpp
+++ b/Tests/LibCrypto/TestHPKE.cpp
@@ -65,3 +65,34 @@ TEST_CASE(round_trip_with_fresh_keys)
     auto opened = TRY_OR_FAIL(Crypto::HPKE::open(kp.private_key, kp.public_key, sealed.enc, "sealed-input/1"sv.bytes(), "slot"sv.bytes(), sealed.ciphertext));
     EXPECT_EQ(opened.bytes(), "hello"sv.bytes());
 }
+
+TEST_CASE(seal_rejects_off_curve_recipient_key)
+{
+    // Flip one byte of pkRm's y coordinate: still 65 bytes, still an 0x04 prefix, no longer on P-256.
+    auto off_curve = MUST(ByteBuffer::copy(pkRm.bytes()));
+    off_curve[64] ^= 0x01;
+    EXPECT(Crypto::HPKE::seal(off_curve, info, aad, pt).is_error());
+}
+
+TEST_CASE(open_rejects_wrong_length_enc)
+{
+    auto kp = TRY_OR_FAIL(Crypto::HPKE::derive_key_pair(ikmR));
+    auto short_enc = pkEm.bytes().slice(0, 64);
+    EXPECT(Crypto::HPKE::open(kp.private_key, pkRm, short_enc, info, aad, ct).is_error());
+}
+
+TEST_CASE(open_rejects_ciphertext_shorter_than_tag)
+{
+    auto kp = TRY_OR_FAIL(Crypto::HPKE::derive_key_pair(ikmR));
+    auto truncated = ct.bytes().slice(0, 15);
+    EXPECT(Crypto::HPKE::open(kp.private_key, pkRm, pkEm, info, aad, truncated).is_error());
+}
+
+TEST_CASE(round_trip_of_empty_plaintext)
+{
+    auto kp = TRY_OR_FAIL(Crypto::HPKE::generate_key_pair());
+    auto sealed = TRY_OR_FAIL(Crypto::HPKE::seal(kp.public_key, info, aad, ReadonlyBytes {}));
+    EXPECT_EQ(sealed.ciphertext.size(), 16u);
+    auto opened = TRY_OR_FAIL(Crypto::HPKE::open(kp.private_key, kp.public_key, sealed.enc, info, aad, sealed.ciphertext));
+    EXPECT(opened.is_empty());
+}
