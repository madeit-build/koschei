+// Composition text is dropped until the recipient key has arrived, like keyboard and paste input (see EventHandler):
+// text that reaches the field before it can be sealed would sit unsealed in the value.
+static bool sealed_input_target_is_not_ready(InputEventsTarget& target)
+{
+    auto* text_control = as_if<HTML::FormAssociatedTextControlElement>(target);
+    if (!text_control)
+        return false;
+    auto* input = as_if<HTML::HTMLInputElement>(text_control->text_control_to_html_element());
+    return input && input->sealed_field() && !input->sealed_field()->is_ready();
+}
+
