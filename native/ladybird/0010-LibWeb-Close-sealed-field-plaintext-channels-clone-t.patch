-// The sealed-fields directive names autocomplete tokens; an <input> whose autocomplete attribute's last
-// token is listed gets a SealedField as if it were a <sealedinput>. Enforced policies only.
+// The sealed-fields directive names autofill field names; an <input> whose parsed autocomplete field name is listed
+// gets a SealedField as if it were a <sealedinput>. Enforced policies only.
 bool SealedField::document_policy_seals_autocomplete_token(DOM::Document const& document, Utf16View token)
 {
     if (token.is_empty())
@@ -90,33 +93,22 @@ bool SealedField::document_policy_seals_autocomplete_token(DOM::Document const&
     return false;
 }
 
-// HTML "ASCII whitespace": TAB, LF, FF, CR, SPACE (not VT).
-static bool is_html_ascii_whitespace(char16_t code_unit)
-{
-    return code_unit == u' ' || code_unit == u'\t' || code_unit == u'\n' || code_unit == u'\f' || code_unit == u'\r';
-}
-
-static Utf16View last_ascii_whitespace_token(Utf16View input)
-{
-    size_t end = input.length_in_code_units();
-    while (end > 0 && is_html_ascii_whitespace(input.code_unit_at(end - 1)))
-        --end;
-    size_t start = end;
-    while (start > 0 && !is_html_ascii_whitespace(input.code_unit_at(start - 1)))
-        --start;
-    return input.substring_view(start, end - start);
-}
-
 GC::Ptr<SealedField> SealedField::create_if_policy_applies(JS::Realm& realm, HTMLInputElement& element)
 {
-    auto autocomplete = element.get_attribute(AttributeNames::autocomplete);
-    if (!autocomplete.has_value())
+    if (!element.has_attribute(AttributeNames::autocomplete))
         return nullptr;
-    // autocomplete may carry section/contact tokens before the field name; the field name is last.
-    auto token = last_ascii_whitespace_token(autocomplete->utf16_view());
-    if (token.is_empty())
+    // HTML's autofill processing model yields the field name, so "billing cc-number" matches a cc-number directive.
+    // With a non-autofill credential type the model leaves "webauthn" as the field name (its step 16 never reassigns
+    // field); the directive names the credential field in front of that token.
+    auto details = element.parse_autocomplete_attribute();
+    auto field_name = details.field_name;
+    if (details.credential_type.has_value()) {
+        auto tokens = element.autocomplete_tokens();
+        field_name = tokens.size() >= 2 ? tokens[tokens.size() - 2] : Utf16String {};
+    }
+    if (field_name.is_empty())
         return nullptr;
-    if (!document_policy_seals_autocomplete_token(element.document(), token))
+    if (!document_policy_seals_autocomplete_token(element.document(), field_name.utf16_view()))
         return nullptr;
     return create(realm, element);
 }
