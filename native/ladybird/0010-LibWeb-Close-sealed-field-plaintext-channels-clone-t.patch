     // 2. Fire a clipboard event named paste.
-    bool event_was_not_canceled = fire_clipboard_event(*document, HTML::EventNames::paste, data_transfer);
+    // A paste into a sealed <input> is not announced to the page: the event's clipboardData is the plaintext about
+    // to enter the field. The UA paste itself still runs below, gated on the field being ready.
+    bool event_was_not_canceled = true;
+    if (!paste_target_is_sealed_input(*document))
+        event_was_not_canceled = fire_clipboard_event(*document, HTML::EventNames::paste, data_transfer);
     data_store->set_mode(HTML::DragDataStore::Mode::Protected);
 
     // 3. If the event was not canceled, then: if there is a selection or cursor in an editable context where
