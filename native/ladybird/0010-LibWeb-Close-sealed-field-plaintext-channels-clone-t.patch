 }
 
+// Same entry point the form-submission navigation uses: a request for the action with the document's policy
+// container, checked as a "form-submission" navigation so only form-action directives can block it.
+static bool form_action_policy_blocks(DOM::Document& document, URL::URL const& action)
+{
+    auto& realm = relevant_realm(document);
+    auto request = Fetch::Infrastructure::Request::create(realm.vm());
+    request->set_url(action);
+    request->set_client(&document.relevant_settings_object());
+    request->set_policy_container(document.policy_container());
+    auto result = ContentSecurityPolicy::should_navigation_request_of_type_be_blocked_by_content_security_policy(request, ContentSecurityPolicy::Directives::Directive::NavigationType::FormSubmission);
+    return result == ContentSecurityPolicy::Directives::Directive::Result::Blocked;
+}
