+// The paste lands in the active input events target; the focused area is where the clipboard event would go.
+static bool paste_target_is_sealed_input(DOM::Document& document)
+{
+    if (auto* target = document.active_input_events_target(); target && sealed_input_for(*target))
+        return true;
+    if (auto focused_area = document.focused_area(); focused_area && sealed_input_for(*focused_area))
+        return true;
+    return false;
+}
+
 // https://w3c.github.io/clipboard-apis/#fire-a-clipboard-event
