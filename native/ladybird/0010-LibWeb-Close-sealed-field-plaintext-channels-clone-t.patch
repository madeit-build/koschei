     DOM::EventInit init {};
@@ -387,8 +410,8 @@ void SealedField::reseal(Utf16View plaintext)
 
     auto padded = pad_plaintext(utf8.bytes());
     auto sealed = ::Crypto::HPKE::seal(m_recipient_public_key, hpke_info.bytes(), m_slot_aad, padded);
-    // The well-known JWK was syntactically valid, but the engine only learns whether x/y form a usable
-    // curve point at the first seal. This is the deferred half of the recipient-invalid check.
+    // The recipient key was checked on the curve at discovery, so a failure here is HPKE itself refusing; fail
+    // closed rather than expose an empty or stale envelope.
     if (sealed.is_error())
         return fail("recipient-invalid"sv);
     auto enc = MUST(encode_base64url(sealed.value().enc, AK::OmitPadding::Yes));
@@ -422,6 +445,9 @@ void SealedField::detach()
