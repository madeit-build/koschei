 {
     // Fail closed while re-discovering: a stale key must never be paired with a fresh slot AAD, and a
@@ -193,6 +198,10 @@ void SealedField::start()
     // file:, about:, blob: and data: actions have opaque origins; there is no recipient to discover.
     if (action->origin().is_opaque())
         return fail("insecure-action"sv);
+    // The page's form-action policy gates the recipient the same way it gates the eventual submission, so retargeting
+    // the form at an origin the policy forbids cannot redirect the seal.
+    if (form_action_policy_blocks(document, *action))
+        return fail("insecure-action"sv);
 
     // 3. The slot binds the envelope to this origin, this action (origin + path), and this field name.
     auto action_origin = action->origin().serialize();
@@ -224,6 +233,10 @@ void SealedField::start()
         response = response->unsafe_response();
         if (!Fetch::Infrastructure::is_ok_status(response->status()))
             return fail("recipient-unreachable"sv);
+        // The key set is JSON or it is not a key set; a mislabeled body is a recipient fault, not a network one.
+        auto mime_type = Fetch::Infrastructure::extract_mime_type(response->header_list());
+        if (!mime_type.has_value() || mime_type->essence() != "application/json"sv)
+            return fail("recipient-invalid"sv);
         body_bytes.visit(
             [&](Core::ImmutableBytes const& bytes) { process_well_known(bytes.bytes()); },
             [&](auto const&) { fail("recipient-unreachable"sv); });
@@ -260,6 +273,15 @@ void SealedField::process_well_known(ReadonlyBytes body)
         point[0] = 0x04;
         point.overwrite(1, x_bytes.value().data(), 32);
         point.overwrite(33, y_bytes.value().data(), 32);
+        // A well-formed JWK can still name coordinates off the curve; such a key can never seal, so skip it now
+        // rather than reporting ready and failing at the first keystroke.
+        auto parsed_point = ::Crypto::Curves::SECPxxxr1Point::from_uncompressed(point);
+        if (parsed_point.is_error())
+            continue;
+        ::Crypto::Curves::SECP256r1 curve;
+        auto is_valid_point = curve.is_valid_point(parsed_point.release_value());
+        if (is_valid_point.is_error() || !is_valid_point.value())
+            continue;
         return become_ready(*kid, move(point));
     }
     fail("recipient-invalid"sv);
@@ -274,7 +296,8 @@ void SealedField::become_ready(String kid, ByteBuffer recipient_public_key)
     // Seal whatever is already in the box (a page-supplied value attribute, say) so the envelope never disagrees with
     // the visible text, and so an untouched required field is invalid rather than blank-and-valid.
     reseal(m_element->sealed_plaintext());
-    // A first seal against an unusable curve point fails the field; sealed-error has already been dispatched.
+    // The key was validated on the curve before we got here, so this only trips if sealing itself fails; then
+    // sealed-error has already been dispatched and sealed-ready must not follow it.
     if (m_failed)
